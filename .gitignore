# --- Python: bytecode e cache ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Distribuição / build ---
dist/
build/
*.egg-info/
*.egg
.eggs/
wheels/

# --- Ambientes virtuais ---
.venv/
venv/
env/
ENV/

# --- Testes e coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
.cache/

# --- Lint e type checking ---
.ruff_cache/
.mypy_cache/
.pyre/
.pytype/

# --- Variáveis de ambiente ---
.env
.env.local
.env.*.local

# --- Logs ---
*.log

# --- Projetos de teste gerados pelo template ---
